{
  "name": "backend-garmin-trakker",
  "version": "1.0.2",
  "description": "Backend for backendGarminTrakker",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "seed": "cross-env NODE_ENV=development MONGO_DB_NAME=garmintrakker ts-node src/seeds/seedDemoData.ts",
    "seed:demo": "cross-env NODE_ENV=development MONGO_DB_NAME=garmintrakker ts-node src/seeds/seedDemoData.ts",
    "seed-users": "npm run seed:demo",
    "seed-groups": "npm run seed:demo",
    "lint": "eslint 'src/**/*.ts'",
    "test": "ts-node tests/routeProgressService.test.ts",
    "migrate-users": "cross-env NODE_ENV=development ts-node src/scripts/migrateUsers.ts",
    "migrate-users:prod": "cross-env NODE_ENV=production ts-node src/scripts/migrateUsers.ts"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongodb": "^4.3.0",
    "resend": "^6.10.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash": "^4.17.14",
    "@types/node": "^20.11.19",
    "cross-env": "^7.0.3",
    "eslint": "^8.49.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
